# PostgreSQL connection string used by the running app (Neon's pooled
# connection in production, local Postgres or Neon in dev).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/fairshare"

# Direct (non-pooled) connection string, used only by the Prisma CLI for
# `prisma migrate deploy` / `prisma migrate dev` — Neon's pooled connection
# doesn't support the DDL statements migrations require. Against Neon this
# is the connection string WITHOUT "-pooler" in the hostname. Locally,
# where there's no pooler, just set it to the same value as DATABASE_URL.
DIRECT_URL="postgresql://user:password@localhost:5432/fairshare"

# Port the Express server listens on
PORT=5000

# JWT secret — used for signing auth tokens. Set a long random string.
JWT_SECRET="replace_with_a_long_random_secret"

# Comma-separated list of allowed frontend origins for CORS.
# In production, set this to your deployed Vercel URL(s), e.g.
# "https://fairshare.vercel.app,https://fairshare-git-main-yourname.vercel.app"
CLIENT_ORIGIN="http://localhost:5173"

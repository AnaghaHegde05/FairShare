# Variables for `docker compose up` (see docker-compose.yml).
# Copy this file to `.env` in this same folder to override any default;
# docker compose loads it automatically. Never commit the real `.env`
# (already covered by .gitignore).
#
# Running the backend/frontend directly (without Docker) instead? Use
# backend/.env.example and frontend/.env.example — those are unchanged
# and still work exactly as before (see README.md → "Running Locally").

# PostgreSQL, used by the `db` container and by the backend to connect to it.
POSTGRES_USER=fairshare
POSTGRES_PASSWORD=fairshare_dev_password
POSTGRES_DB=fairshare

# JWT secret the backend uses to sign auth tokens. This is a placeholder —
# set your own long random string, and never reuse it anywhere real.
JWT_SECRET=replace_with_a_long_random_secret

# Origin(s) the backend's CORS policy allows — the frontend's host-mapped port.
CLIENT_ORIGIN=http://localhost:5173

# Base URL the frontend (running in your browser) uses to reach the
# backend. The browser is outside the Docker network, so this must be the
# backend's HOST-mapped port, not the internal service name "backend".
VITE_API_URL=http://localhost:5000
